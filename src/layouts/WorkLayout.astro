---
import Layout from "./Layout.astro";
import "../styles/work.css";
const { frontmatter } = Astro.props;
const { title, image, tags, note } = frontmatter;
---

<Layout>
  <main>
    <div class="hero">
      <img src={image.url} alt={image.alt} />
    </div>
    <h1>{title}</h1>
    <p class="tags">
      <span>tags: </span>
      {
        tags.map((tag) => {
          return <span class="tag">{tag}</span>;
        })
      }
    </p>
    {
      !!note && (
        <div class="note">
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-info-icon lucide-info"
            >
              <>
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4" />
                <path d="M12 8h.01" />
              </>
            </svg>
          </span>
          <span>{note}</span>
        </div>
      )
    }
    <slot />
  </main>
</Layout>

<style>
  body {
    max-inline-size: 80ch;
    margin: 0 auto;
    padding: var(--spacer);
  }
  main {
    margin-top: var(--spacer-2);
  }
  .hero {
    img {
      border: 2px solid var(--foreground);
      border-radius: var(--spacer);
      max-width: 80ch;
      width: 100%;
      margin-block-end: var(--spacer-3);
    }
  }
  .tags {
    display: flex;
    gap: var(--spacer);
    align-items: center;
    margin-block-start: var(--spacer-05);
    margin-block-end: var(--spacer);
  }
  .tag {
    background-color: var(--black-9);
    padding: var(--spacer-05);
    border-radius: var(--spacer-05);
  }
  .note {
    padding: var(--spacer);
    background-color: var(--black-9);
    border-radius: var(--spacer-05);
    display: flex;
    gap: var(--spacer-05);

    svg {
      min-inline-size: 1.25rem;
    }
  }
</style>
