---
import Header from "../components/Header.astro";
import "../styles/reset.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/astro-portfolio/favicon.svg" />
    <link rel="icon" href="/astro-portfolio/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Jered's Portfolio Site</title>
  </head>
  <Header />
  <body>
    <slot />
  </body>
  <!-- entirely ornamental, to remove from a11y tree -->
  <div class="star-bg" aria-hidden="true"></div>
</html>

<style>
  html {
    background-color: var(--background);
    color: var(--foreground);
  }
</style>
