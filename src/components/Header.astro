---
const {
  url: { pathname },
} = Astro;

const links = [
  {
    text: "About",
    href: "/#about",
    isCurrent: pathname === "/",
  },
  {
    text: "Work",
    href: "/work",
    isCurrent: pathname === "/work",
  },
  // {
  //   text: "Resume",
  //   href: "/resume.pdf",
  // },
];
---

<header>
  <ul>
    {
      links.map(({ href, text, isCurrent }) => {
        return (
          <li>
            <a class={`${isCurrent ? "current" : ""}`} href={href}>
              <span>{text}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</header>

<style>
  header {
    padding: var(--spacer-2);
  }
  ul {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: var(--spacer);
    list-style-type: none;
  }
  a {
    color: var(--foreground);
    padding: var(--spacer-05) var(--spacer);
    text-decoration: none;
    border-radius: var(--spacer-2);
    font-family: var(--display);
    text-transform: uppercase;
    font-weight: 600;
    transition: 0.3s all ease;
  }

  a:hover:not(.current),
  a.current {
    background-color: oklch(from var(--foreground) l c h / 0.9);
    color: var(--background);
  }

  /* underline animation */
  /* a:after {
    content: "";
    display: block;
    padding-bottom: 1px;
    border-bottom: 2px solid var(--foreground);
    transition: transform 0.3s ease;
    transform: scaleX(0);
    transform-origin: left;
  }
  a:hover:not(.current):after,
  a.current:after {
    transform: scaleX(100%);
  } */
  a:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: var(--spacer-05);
  }
</style>
