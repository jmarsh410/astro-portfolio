---
import Tags from "./Tags.astro";

const allWork = Object.values(
  import.meta.glob("../pages/work/*.md", { eager: true }),
);
const sortedWork = allWork.sort((a: any, b: any) => {
  return new Date(a.frontmatter.date) > new Date(b.frontmatter.date) ? -1 : 1;
});
---

<main>
  <section id="hero">
    <h1>
      I'm JE<span>RED MARS</span>HALL. <br /> I make things for the Web.
    </h1>
    <p>Performant, delightful, accessible things.</p>
  </section>
  <div class="solar-system-container">
    <div class="solar-system">
      <div class="sun"></div>
      <div class="planets">
        <div></div>
        <div></div>
        <div></div>
        <div class="mars"></div>
      </div>
    </div>
  </div>
  <section class="work">
    <h2>Work</h2>
    <ul class="card-list">
      {
        sortedWork.map((work: any) => {
          const {
            frontmatter: { thumb, title, tags },
          } = work;
          return (
            <li>
              <article class="card">
                <a href={work.url}>
                  <div class="card__content">
                    {thumb?.url && <img src={thumb.url} alt={thumb.alt} />}
                    <div class="card__text">
                      <div class="title">
                        {title}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="lucide lucide-move-right-icon lucide-move-right"
                        >
                          <>
                            <path d="M18 8L22 12L18 16" />
                            <path d="M2 12H22" />
                          </>
                        </svg>
                      </div>
                      {/* <div class="tags">
                        <Tags tags={tags} limit={3} />
                      </div> */}
                    </div>
                  </div>
                </a>
              </article>
            </li>
          );
        })
      }
    </ul>
  </section>
</main>

<style>
  @keyframes spin {
    0% {
      transform: rotateZ(0deg);
    }
    100% {
      transform: rotateZ(-360deg);
    }
  }
  main {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-2);
  }
  #hero {
    text-align: center;
    line-height: 1.75;
    text-wrap: pretty;
    margin: var(--spacer-4) 0;
    font-family:
      ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas,
      "DejaVu Sans Mono", monospace;
  }
  h1 {
    text-wrap: pretty;
    font-size: clamp(1.5rem, 2vw + 1rem, 3rem);
    margin-block-end: var(--spacer-2);
    span {
      color: red;
    }
  }
  h2 {
    text-align: center;
  }
  .solar-system-container {
    position: relative;
  }
  .solar-system {
    position: relative;
    perspective: 1000px;
    aspect-ratio: 3/1;
    overflow: hidden;
  }
  .sun {
    width: 20px;
    height: 20px;
    background-color: var(--foreground);
    /* background-color: yellow; */
    border-radius: 100%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    position: absolute;
  }
  /* planets */
  .planets {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    place-items: center;

    transform: translate(-50%, -50%) rotateX(80deg) rotateY(-10deg);
    transform-style: preserve-3d;

    position: absolute;
    left: 50%;
    top: 50%;

    .sun {
      background-color: var(--foreground);
    }

    div {
      background-color: transparent;
      border-radius: 100%;
      border: 2px solid var(--foreground);

      /* progressively enhance the sibling-index stuff */
      width: calc(80vw * (sibling-index() / 4));
      height: calc(80vw * (sibling-index() / 4));

      max-inline-size: calc(40rem * (sibling-index() / 4));
      max-block-size: calc(40rem * (sibling-index() / 4));

      grid-area: 1/1;
    }

    .mars {
      position: relative;
      animation: spin 20s linear infinite;
      transform-style: preserve-3d;

      &:before,
      &:after {
        content: "";
        display: block;
        width: 10px;
        height: 10px;
        border-radius: 100%;
        background-color: red;
        position: absolute;
        right: 0;
        top: calc(50% + 2px);
      }
      &:before {
        transform: translate(50%, -50%) rotateX(90deg);
      }
      &:after {
        transform: translate(50%, -50%) rotateX(90deg) rotateY(90deg);
      }
    }
  }
  .card-list {
    display: grid;
    gap: var(--spacer);

    grid-template-columns: repeat(1, 1fr);

    @media screen and (width > 360px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media screen and (width > 768px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  .card {
    a {
      color: var(--foreground);
      font-family: var(--display);
      text-decoration: none;
      font-weight: bold;
      display: flex;
      flex-direction: column;
    }

    svg {
      margin-inline-start: var(--spacer-025);
    }
  }
  .card__content {
    border: 2px solid var(--foreground);
    border-radius: var(--spacer);
    background-color: var(--black-9);
    overflow: hidden;

    img {
      width: 100%;
    }
  }
  .card__text {
    padding: var(--spacer);

    .title {
      display: flex;
      align-items: center;
    }
  }

  .tags {
    margin-block-start: var(--spacer-05);
  }
</style>
